    {
      "id": "_github_dependabot_react_peer_dependency_exclusion",
      "label": "React/React-DOM Peer Dependency Ignore Rule",
      "file_type": "rationale",
      "source_file": ".github/dependabot.yml",
      "source_location": "L20-L28",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "react and react-dom are peerDependencies expressing an intentional dual-major support range (^18.2.0 || ^19.0.0), not pinned installs that need patching. Dependabot updates to peer ranges only widen or narrow that compatibility promise, a deliberate maintainer call. Bump peer ranges by hand when a new React major is actually adopted."
    }
