    {
      "id": "claude_non_interactive_tool_guidance",
      "label": "Non-Interactive Tool Guidance",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L47-L55",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Agents/CI must avoid commands that block indefinitely: use `pnpm test:unit --run` (omitting --run starts watch mode), `pnpm build:storybook` instead of `pnpm dev`, and `pnpm install --frozen-lockfile` to prevent interactive prompts."
    },
    {
      "id": "claude_pre_commit_hooks_section",
      "label": "Pre-Commit Hooks Section",
      "file_type": "document",
      "source_file": "CLAUDE.md",
      "source_location": "L57-L77",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "claude_component_authorship_convention",
      "label": "Component Authorship Convention",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L81-L86",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Components live flat under src/components/ (no per-component subdirectories), colocated with .test.tsx and .stories.tsx; everything public is exported through src/index.ts; no default exports, to keep the public API surface explicit and discoverable."
    },
    {
      "id": "claude_styling_convention",
      "label": "Styling Convention (unstyled-by-default, structural CSS exception)",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L87-L96",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Components must be unstyled or accept className so consumers theme them; site-level theming is the consumer's job (see website/CLAUDE.md). Exception: ValuesCloud, SectionHeading, AccordionItem ship real structural CSS via a separate `./css` export subpath (registered in src/styles.ts) because their layout/spacing can't reasonably be left to every consumer; colours/fonts still read from --bl-* custom properties with fallbacks so it stays themable, and no Tailwind syntax is used since the package has no Tailwind pipeline."
    },
    {
      "id": "claude_accessibility_convention",
      "label": "Accessibility Convention",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L98-L101",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Use semantic HTML, add ARIA only where semantics are insufficient, and ensure all interactive elements are keyboard-navigable."
    },
    {
      "id": "claude_typescript_convention",
      "label": "TypeScript Convention (strict, no any)",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L103-L106",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Strict mode, no `any`; prop types named ComponentNameProps and exported alongside the component for a consistent, type-safe public API."
    },
