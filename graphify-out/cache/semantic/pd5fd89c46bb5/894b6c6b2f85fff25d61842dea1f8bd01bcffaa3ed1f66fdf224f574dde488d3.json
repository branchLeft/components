      "id": "claude_node_version_policy",
      "label": "Node Version Policy (nvm use)",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": "L11-L17",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Repo pins Node via .nvmrc; always run `nvm use` before any commands to activate the correct version rather than hardcoding version paths or manipulating $PATH manually."
    },
